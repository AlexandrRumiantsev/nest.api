{
    "version": 2,
    "builds": [
      {
        "src": "src/main.ts",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "src/main.ts",
        "methods": [
          "GET",
          "POST",
          "PUT",
          "DELETE"
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/swagger-ui/(.*)",
        "destination": "/_next/static/swagger-ui/$1"
      }
    ]
}